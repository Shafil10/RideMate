generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  university   String
  // Shown to the other party only after a booking connects them (driver <-> rider),
  // never to someone just browsing rides — see serializeRide/serializeRequest.
  phoneNumber  String?
  // "passenger" | "driver" — a soft UI default only (which home screen a user lands
  // on after login), never checked as a server-side authorization gate. Anyone can
  // still offer or request a ride regardless of this value.
  defaultRole  String   @default("passenger")
  createdAt    DateTime @default(now())

  // Driver-only vehicle details, collected at signup. Null for passengers.
  vehicleMake  String?
  vehicleModel String?
  vehicleColor String?
  vehiclePlate String?
  vehicleSeats Int?

  rides            Ride[]
  chatMessages     ChatMessage[]
  bookings         Booking[]
  favorites        Favorite[]
  ratingsGiven     Rating[]                 @relation("RatingsGiven")
  ratingsReceived  Rating[]                 @relation("RatingsReceived")
  rideRequests     RideRequest[]            @relation("RideRequestInitiator")
  requestBookings  RideRequestParticipant[]
  messagesSent     Message[]                @relation("MessagesSent")
  messagesReceived Message[]                @relation("MessagesReceived")
}

// Holds a signup until its OTP is verified — kept separate from User so an
// abandoned or mistyped-code attempt never squats the unique email on the
// real, joined-everywhere User table. Promoted to a real User row (and
// deleted) on successful verification.
model PendingSignup {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  university   String
  phoneNumber  String?
  defaultRole  String   @default("passenger")

  vehicleMake  String?
  vehicleModel String?
  vehicleColor String?
  vehiclePlate String?
  vehicleSeats Int?

  otpCode      String
  otpExpiresAt DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Holds a "forgot password" OTP until verified — same shape/lifecycle as
// PendingSignup, kept separate since it's tied to an *existing* User rather
// than staging a new one.
model PasswordReset {
  id           String   @id @default(cuid())
  email        String   @unique
  otpCode      String
  otpExpiresAt DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Ride {
  id            String   @id @default(cuid())
  type          String
  origin        String
  originLat     Float?
  originLng     Float?
  destination   String
  destLat       Float?
  destLng       Float?
  university    String
  departureTime DateTime
  seatsTotal    Int
  seatsTaken    Int      @default(0)
  farePerSeat   Int
  createdAt     DateTime @default(now())

  driver   User   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  bookings         Booking[]
  favorites        Favorite[]
  ratings          Rating[]
  messages         Message[]
  fulfilledRequest RideRequest?
}

model Booking {
  id              String    @id @default(cuid())
  pickupPoint     String
  pickupLat       Float?
  pickupLng       Float?
  dropoffPoint    String?
  dropoffLat      Float?
  dropoffLng      Float?
  // Segment fare snapshot, computed once at join time and never recomputed later —
  // same pattern as cancellationFee below.
  fare            Int?
  status          String    @default("confirmed") // "confirmed" | "cancelled"
  cancellationFee Int?
  createdAt       DateTime  @default(now())
  cancelledAt     DateTime?

  ride   Ride   @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rideId String

  rider   User   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId String
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ride   Ride   @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rideId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, rideId])
}

// A passenger-initiated request for a ride that doesn't exist yet — other
// passengers can pool onto it, and driver-students can browse open requests and
// fulfill one if their schedule/seats match. On fulfillment, a real Ride + one
// real Booking per participant get created, so it plugs into the existing
// rating/history/recommendation machinery with no changes to that code.
model RideRequest {
  id          String   @id @default(cuid())
  origin      String
  originLat   Float?
  originLng   Float?
  destination String
  destLat     Float?
  destLng     Float?
  university  String
  desiredTime DateTime
  status      String   @default("open") // "open" | "fulfilled" | "cancelled"
  createdAt   DateTime @default(now())

  initiator   User   @relation("RideRequestInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  initiatorId String

  fulfilledByRide   Ride?   @relation(fields: [fulfilledByRideId], references: [id])
  fulfilledByRideId String? @unique

  participants RideRequestParticipant[]
}

model RideRequestParticipant {
  id           String   @id @default(cuid())
  pickupPoint  String
  pickupLat    Float?
  pickupLng    Float?
  dropoffPoint String
  dropoffLat   Float?
  dropoffLng   Float?
  createdAt    DateTime @default(now())

  request   RideRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String

  rider   User   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId String

  @@unique([requestId, riderId])
}

model Rating {
  id        String   @id @default(cuid())
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  ride   Ride   @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rideId String

  rater   User   @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  raterId String

  rated   User   @relation("RatingsReceived", fields: [ratedId], references: [id], onDelete: Cascade)
  ratedId String

  @@unique([rideId, raterId, ratedId])
}

// A simple per-ride, per-counterpart thread — not a group chat. senderId and
// recipientId are always {driver, one specific rider} for the ride in
// question; a ride with three passengers has three separate threads, one per
// rider, each only visible to that rider and the driver.
model Message {
  id          String   @id @default(cuid())
  body        String
  createdAt   DateTime @default(now())

  ride   Ride   @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rideId String

  sender   User   @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  senderId String

  recipient   User   @relation("MessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String

  @@index([rideId, senderId, recipientId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  sessionId  String
  message    String
  reply      String
  topicId    String
  createdAt  DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([sessionId])
}

model Stat {
  id    String @id @default(cuid())
  value String
  label String
  order Int    @default(0)
}

model University {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)
}

model Testimonial {
  id    String @id @default(cuid())
  name  String
  text  String
  order Int    @default(0)
}
