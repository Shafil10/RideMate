generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  university   String
  createdAt    DateTime @default(now())

  rides        Ride[]
  chatMessages ChatMessage[]
  bookings     Booking[]
  favorites    Favorite[]
}

model Ride {
  id            String   @id @default(cuid())
  type          String
  origin        String
  destination   String
  university    String
  departureTime DateTime
  seatsTotal    Int
  seatsTaken    Int      @default(0)
  farePerSeat   Int
  createdAt     DateTime @default(now())

  driver   User   @relation(fields: [driverId], references: [id])
  driverId String

  bookings  Booking[]
  favorites Favorite[]
}

model Booking {
  id              String    @id @default(cuid())
  pickupPoint     String
  pickupLat       Float?
  pickupLng       Float?
  status          String    @default("confirmed") // "confirmed" | "cancelled"
  cancellationFee Int?
  createdAt       DateTime  @default(now())
  cancelledAt     DateTime?

  ride   Ride   @relation(fields: [rideId], references: [id])
  rideId String

  rider   User   @relation(fields: [riderId], references: [id])
  riderId String
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ride   Ride   @relation(fields: [rideId], references: [id])
  rideId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([userId, rideId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  message    String
  reply      String
  topicId    String
  createdAt  DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model Stat {
  id    String @id @default(cuid())
  value String
  label String
  order Int    @default(0)
}

model University {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)
}

model Testimonial {
  id    String @id @default(cuid())
  name  String
  text  String
  order Int    @default(0)
}
