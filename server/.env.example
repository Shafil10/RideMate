DATABASE_URL="get-one-free-at-neon.com"
JWT_SECRET="replace-with-a-long-random-secret"
GROQ_API_KEY="get-one-free-at-console.groq.com"
# Gmail API over HTTPS (not SMTP — Render's free tier blocks outbound SMTP).
# GMAIL_USER is the sending Gmail/Google Workspace address. GMAIL_CLIENT_ID/SECRET/
# REFRESH_TOKEN come from a one-time OAuth2 setup — run:
#   npx tsx scripts/gmail-oauth-setup.ts <client-id> <client-secret>
# after creating a "Desktop app" OAuth client in Google Cloud Console with the Gmail
# API enabled (see comments at the top of that script for the full walkthrough).
GMAIL_USER="your-gmail-address@gmail.com"
GMAIL_CLIENT_ID="xxxx.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-oauth-client-secret"
GMAIL_REFRESH_TOKEN="printed-by-gmail-oauth-setup-script"
