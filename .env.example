# Only used by the native Android app — your dev machine's LAN IP, so a real
# phone can reach the backend. Changes whenever you switch WiFi networks.
VITE_API_HOST=192.168.1.x

# Only used for a production web build (Vercel) talking to a separately
# hosted backend (Render). Leave unset in local dev — the Vite proxy in
# vite.config.ts handles "/api" locally instead.
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
